# ai-jail sandbox configuration
# https://github.com/akitaonrails/ai-jail
# Edit freely. Regenerate with: ai-jail --clean --init

command = [
    "codex",
    "--dangerously-bypass-approvals-and-sandbox",
    "codex",
    "resume:last",
]
rw_maps = [
    "~/.codex",
    "~/.gemini",
    "~/.config/gh",
    "~/.codex",
    "~/.config/gh",
]
no_display = false
network = true
x11 = true
terminal_passthrough = true
systemd_user = true
