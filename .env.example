# Local Compose project and host-side publication. The UI is protected by the
# built-in operator login and is available to devices on the LAN by default.
# Do not forward this port from your router to the public internet.
COMPOSE_PROJECT_NAME=awm
AWM_HOST_BIND=0.0.0.0
AWM_HOST_PORT=8878

# Single local operator account. Generate a password hash with `pnpm auth:hash`
# and replace the placeholder before starting the service. Quote the full PHC
# string with single quotes because it contains `$` characters.
AWM_AUTH_USERNAME=operator
AWM_AUTH_PASSWORD_HASH='REPLACE_WITH_OUTPUT_FROM_PNPM_AUTH_HASH'
AWM_AUTH_SESSION_TTL_SECONDS=43200
# Leave blank unless a reverse proxy is deliberately deployed in front of AWM.
# If set, list only the proxy's source IP/CIDR; never use 0.0.0.0/0 or ::/0.
AWM_TRUST_PROXY=
# Optional dedicated GET/HEAD /metrics credential: digest from pnpm metrics:token only.
# Keep the raw token exclusively in a private Prometheus credentials file.
AWM_METRICS_TOKEN_SHA256=

# Container/application bootstrap
AWM_BIND=0.0.0.0
AWM_PORT=8787
AWM_DB_PATH=/data/window-manager.db
AWM_LOG_LEVEL=info
AWM_TIMEZONE=America/Sao_Paulo
# Optional deterministic provider for local development. False hides a persisted fake provider
# from the UI, JSON API and metrics without deleting its SQLite history.
AWM_FAKE_PROVIDER_ENABLED=false
AWM_CODEX_ENABLED=true
# Enabled by default; set false to opt out. A fresh database starts with
# automation mode and a "Whenever possible" policy. Choose a target window in
# the UI before actions can be planned. Explicit SQLite choices are preserved.
AWM_CODEX_TRIGGER_ENABLED=true
# Executables resolve through the persistent, atomically switched runtime pins.
# The immutable image binaries remain available as the initial/fallback version.
AWM_CODEX_HOME=/codex-state
AWM_CODEX_EXECUTABLE=/provider-clients/codex/current
# Per-stage timeout for the quota-consuming app-server heartbeat. A timeout
# after turn/start remains uncertain and is never retried automatically.
AWM_CODEX_ACTION_TIMEOUT_SECONDS=60
# Maximum lifetime for an interactive provider sign-in session.
AWM_AUTH_SESSION_TIMEOUT_SECONDS=900
# Antigravity uses its official CLI and a dedicated volume; state is never
# copied from the host HOME or a host keyring.
AWM_ANTIGRAVITY_ENABLED=true
# Enabled by default; set false to opt out. A fresh database starts with
# automation mode and a "Whenever possible" policy. Choose the exact quota
# family/window in the UI before actions can be planned. Explicit SQLite choices
# are preserved.
AWM_ANTIGRAVITY_TRIGGER_ENABLED=true
# Argon monitoring is independent; explicitly enable its experimental prompt action.
AWM_ANTIGRAVITY_ARGON_TRIGGER_ENABLED=false
AWM_ANTIGRAVITY_ARGON_TRIGGER_MODEL=gemini-4-argon-low
# Trigger process timeout in seconds (5–120).
AWM_ANTIGRAVITY_ACTION_TIMEOUT_SECONDS=60
# Default model used for each Antigravity quota family when triggering is enabled.
AWM_ANTIGRAVITY_GEMINI_TRIGGER_MODEL=gemini-3.8-flash-low
AWM_ANTIGRAVITY_CLAUDE_GPT_TRIGGER_MODEL=claude-sonnet-4-6
AWM_ANTIGRAVITY_HOME=/antigravity-state
AWM_ANTIGRAVITY_EXECUTABLE=/provider-clients/antigravity/current
# Internal container path only; leave empty in the normal .env. To unlock a
# persistent keyring, use compose.antigravity-secret.example.yaml as documented.
AWM_ANTIGRAVITY_KEYRING_SECRET_FILE=
# Host file path used only by the ignored local Compose secret override. This is
# a path, not the unlock secret itself; leave unset if the keyring is unlocked.
# AWM_ANTIGRAVITY_KEYRING_SECRET_SOURCE=
# Claude Code uses the official CLI with a dedicated /claude-state volume. Sign in
# from a terminal (AWM never relays Claude.ai codes or tokens):
#   docker compose exec ai-window-manager claude-code-cli auth login
# Usage is read with the official `/usage` local command (no model request).
AWM_CLAUDE_CODE_ENABLED=false
# Off by default. When true, a manual or scheduled start sends one ordinary
# "Hi!" request that counts against BOTH the five-hour and weekly allowance.
# Review docs/adr/009-claude-code-provider.md before enabling.
AWM_CLAUDE_CODE_TRIGGER_ENABLED=false
# Model used only for that request: haiku, sonnet, opus or a claude-* model ID.
AWM_CLAUDE_CODE_TRIGGER_MODEL=haiku
# Timeout in seconds (5–120); a timeout after the request starts stays uncertain.
AWM_CLAUDE_CODE_ACTION_TIMEOUT_SECONDS=60
AWM_CLAUDE_CODE_HOME=/claude-state
AWM_CLAUDE_CODE_EXECUTABLE=/provider-clients/claude_code/current
# Also sets the initial read-only confirmation/pre-dispatch retry delay.
AWM_RECONCILE_INTERVAL_SECONDS=30
# Wakeup cadence; pending confirmations still respect their persisted deadline.
AWM_EXECUTOR_INTERVAL_SECONDS=5
AWM_RETENTION_INTERVAL_SECONDS=86400
