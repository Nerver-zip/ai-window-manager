# Host-side publication. Keep loopback unless you deliberately expose through LAN/VPN/reverse proxy.
AWM_HOST_BIND=127.0.0.1
AWM_HOST_PORT=8787

# Container/application bootstrap
AWM_BIND=0.0.0.0
AWM_PORT=8787
AWM_DB_PATH=/data/window-manager.db
AWM_LOG_LEVEL=info
AWM_TIMEZONE=America/Sao_Paulo
# Optional deterministic provider for local development. False hides a persisted fake provider
# from the UI, JSON API and metrics without deleting its SQLite history.
AWM_FAKE_PROVIDER_ENABLED=false
AWM_CODEX_ENABLED=false
# Quota-consuming trigger gate. Keep false until you explicitly enable
# provider automation in /settings after reviewing the target policy.
AWM_CODEX_TRIGGER_ENABLED=false
# Pinned in the Dockerfile to the official Codex release 0.155.1.
AWM_CODEX_HOME=/codex-state
AWM_CODEX_EXECUTABLE=/opt/codex/bin/codex
# Per-stage timeout for the quota-consuming app-server heartbeat. A timeout
# after turn/start remains uncertain and is never retried automatically.
AWM_CODEX_ACTION_TIMEOUT_SECONDS=30
AWM_RECONCILE_INTERVAL_SECONDS=30
AWM_EXECUTOR_INTERVAL_SECONDS=5
AWM_RETENTION_INTERVAL_SECONDS=86400
