{
  "name": "ai-window-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted manager for AI provider usage windows.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "auth:hash": "tsx scripts/auth-hash.ts",
    "metrics:token": "tsx scripts/metrics-token.ts",
    "provider-clients:check": "tsx scripts/provider-clients-check.ts",
    "provider-clients:bump": "tsx scripts/provider-clients-bump.ts",
    "ui:demo": "tsx scripts/ui-checks/demo-server.ts",
    "ui:shots": "node scripts/ui-checks/shoot.mjs",
    "ui:a11y": "node scripts/ui-checks/a11y-check.mjs",
    "ui:auth-flow": "node scripts/ui-checks/auth-flow.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secret:scan": "./scripts/secret-scan.sh",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm secret:scan"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@node-rs/argon2": "2.2.2",
    "better-sqlite3": "^13.0.3",
    "escape-html": "1.0.3",
    "fastify": "^5.12.7",
    "node-pty": "1.1.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/escape-html": "1.0.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "minimatch@10.2.6": "11.0.4"
    }
  }
}
