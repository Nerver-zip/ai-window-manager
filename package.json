{
  "name": "ai-window-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted manager for AI provider usage windows.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "auth:hash": "tsx scripts/auth-hash.ts",
    "provider-clients:check": "tsx scripts/provider-clients-check.ts",
    "provider-clients:bump": "tsx scripts/provider-clients-bump.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secret:scan": "./scripts/secret-scan.sh",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm secret:scan"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.5.0",
    "node-pty": "1.1.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
